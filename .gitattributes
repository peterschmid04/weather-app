* text=auto
.gitattributes text eol=lf

# Shell scripts must keep LF line endings so they run on Linux/macOS and inside
# Linux containers.
*.sh text eol=lf

# Windows scripts should keep CRLF line endings for double-click and cmd.exe use.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Markdown is rendered on GitHub and should stay stable across platforms.
*.md text eol=lf
